# Server Port on LAN (Default: 3589)
PORT=3589

# Host to bind (0.0.0.0 listens on all LAN interfaces)
HOST=0.0.0.0

# Polling interval in ms for detecting League Client start/stop
LCU_POLL_INTERVAL_MS=2500

# Optional: Custom lockfile path if League of Legends is in a non-standard location
# LOL_LOCKFILE_PATH=C:\Riot Games\League of Legends\lockfile

# CORS allowed origin
CORS_ORIGIN=*
